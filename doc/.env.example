# Copy to doc/.env.local. Fill in your own values there.
BIAI_SOCIAL_APP_ID=
BIAI_SOCIAL_ACCESS_TOKEN=
BIAI_VIDEO_API_KEY=

# Select deepseek or doubao and fill in that provider's settings.
BIAI_AI_PROVIDER=deepseek
DEEPSEEK_API_KEY=
DEEPSEEK_MODEL=
ARK_API_KEY=
DOUBAO_MODEL=

# Local: expose only signed /media/ URLs. Leave the directory empty for .data/uploads.
BIAI_STORAGE_PROVIDER=local
BIAI_MEDIA_PUBLIC_ORIGIN=
BIAI_MEDIA_DIRECTORY=

# OSS: select oss above and fill in the bucket settings.
OSS_ACCESS_KEY_ID=
OSS_ACCESS_KEY_SECRET=
OSS_SECURITY_TOKEN=
OSS_BUCKET=
OSS_REGION=
OSS_ENDPOINT=
OSS_CUSTOM_DOMAIN=
OSS_FILE_DIR=

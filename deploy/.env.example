# Full application URL: BIAI_PUBLIC_ORIGIN + BIAI_BASE_PATH + /
BIAI_PUBLIC_ORIGIN=https://agent.example.com
BIAI_BASE_PATH=/smart-biai-agent
BIAI_BIND_PORT=4178

# Workbench login. Users of this login share conversations, tasks and connection settings.
BIAI_LOGIN_USER=admin
BIAI_LOGIN_PASSWORD=CHANGE_ME_BEFORE_START

# Optional: fill here or use the authenticated connection settings page.
BIAI_SOCIAL_APP_ID=
BIAI_SOCIAL_ACCESS_TOKEN=
# Shared application key for video and image generation.
BIAI_VIDEO_API_KEY=
BIAI_AI_PROVIDER=deepseek
DEEPSEEK_API_KEY=
DEEPSEEK_MODEL=
ARK_API_KEY=
DOUBAO_MODEL=

# Reference material storage. Paths here are paths INSIDE the container.
BIAI_STORAGE_PROVIDER=local
BIAI_MEDIA_PUBLIC_ORIGIN=https://agent.example.com
BIAI_MEDIA_DIRECTORY=
OSS_ACCESS_KEY_ID=
OSS_ACCESS_KEY_SECRET=
OSS_SECURITY_TOKEN=
OSS_BUCKET=
OSS_REGION=
OSS_ENDPOINT=
OSS_CUSTOM_DOMAIN=
OSS_FILE_DIR=biai-agent/references
